{
  "name": "last-train", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5188 --directory public --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "deploy:cloudflare": "pnpm build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false ../../node_modules/.bin/wrangler deploy",
    "audio:generate": "node --experimental-strip-types --env-file-if-exists=../../.env.local scripts/generate-audio.mjs --generate"
  }
}
