{
  "name": "last-train",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5188 --directory public --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "deploy:cloudflare": "pnpm build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy",
    "audio:generate": "node --env-file-if-exists=.env.local scripts/generate-audio.mjs --generate",
    "audio:plan": "node scripts/generate-audio.mjs"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "wrangler": "4.127.1"
  }
}
